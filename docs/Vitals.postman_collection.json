          "name": "Подписать рецепт (врач)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{doctorToken}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/prescriptions/{{prescriptionId}}/sign?confirmWarnings=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "prescriptions", "{{prescriptionId}}", "sign"],
              "query": [{ "key": "confirmWarnings", "value": "true" }]
            }
          }
        },
        {
          "name": "Рецепт пациента — детали",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/prescriptions/{{prescriptionId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "prescriptions", "{{prescriptionId}}"] }
          }
        },
        {
          "name": "QR рецепта",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/prescriptions/{{prescriptionId}}/qr", "host": ["{{baseUrl}}"], "path": ["api", "v1", "prescriptions", "{{prescriptionId}}", "qr"] }
          }
        },
        {
          "name": "Инструкции по приёму",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/prescriptions/{{prescriptionId}}/instructions", "host": ["{{baseUrl}}"], "path": ["api", "v1", "prescriptions", "{{prescriptionId}}", "instructions"] }
          }
        },
        {
          "name": "Все рецепты пациента",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/prescriptions/patients/{{patientUserId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "prescriptions", "patients", "{{patientUserId}}"] }
          }
        }
      ]
    },
    {
      "name": "7. Выздоровление и медкарта",
      "item": [
        {
          "name": "Записать событие выздоровления",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventType\": \"recovery\",\n  \"sourceService\": \"consultation\",\n  \"payloadJson\": \"{\\\"diagnosisIcd10\\\":\\\"J06.9\\\",\\\"outcome\\\":\\\"recovered\\\",\\\"consultationId\\\":\\\"{{consultationId}}\\\"}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/medical-records/patients/{{patientUserId}}/events", "host": ["{{baseUrl}}"], "path": ["api", "v1", "medical-records", "patients", "{{patientUserId}}", "events"] }
          }
        },
        {
          "name": "История болезни пациента",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/medical-records/patients/{{patientUserId}}/history", "host": ["{{baseUrl}}"], "path": ["api", "v1", "medical-records", "patients", "{{patientUserId}}", "history"] }
          }
        },
        {
          "name": "Текущее состояние пациента",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/medical-records/patients/{{patientUserId}}/state", "host": ["{{baseUrl}}"], "path": ["api", "v1", "medical-records", "patients", "{{patientUserId}}", "state"] }
          }
        },
        {
          "name": "История уведомлений пациента",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/notifications/history?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "notifications", "history"],
              "query": [{ "key": "limit", "value": "50" }]
            }
          }
        }
      ]
    },
    {
      "name": "8. Завершение сессии",
      "item": [
        {
          "name": "Logout пациента",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "logout"] }
          }
        }
      ]
    }
  ]
}
