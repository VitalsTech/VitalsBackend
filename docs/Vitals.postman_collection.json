{
  "info": {
    "name": "Vitals — Полный цикл пациента",
    "_postman_id": "b1a7c0de-0000-4000-8000-vitalsfullflow",
    "description": "Сквозной сценарий через API Gateway (http://localhost:5080):\nрегистрация -> логин -> симптомы/триаж -> подбор врача -> консультация -> рецепт -> выздоровление.\n\nТокены и идентификаторы сохраняются автоматически в переменные коллекции тест-скриптами, поэтому запросы нужно выполнять сверху вниз (или прогнать всю коллекцию через Runner).\n\nДоктор-специфичные действия (завершение консультации, выписка/подписание рецепта) используют отдельный токен {{doctorToken}}. Консультация создаётся на залогиненного врача ({{doctorUserId}} из шага логина врача), поэтому join/complete от его имени проходят. Событие выздоровления пишется под токеном пациента (он сам себе разрешает запись в свою медкарту).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5080" },
    { "key": "patientPhone", "value": "" },
    { "key": "patientPassword", "value": "Passw0rd!23" },
    { "key": "doctorPhone", "value": "" },
    { "key": "doctorPassword", "value": "Passw0rd!23" },
    { "key": "patientToken", "value": "" },
    { "key": "doctorToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "patientUserId", "value": "" },
    { "key": "doctorUserId", "value": "" },
    { "key": "searchDoctorId", "value": "" },
    { "key": "triageSessionId", "value": "" },
    { "key": "routingDecisionId", "value": "" },
    { "key": "consultationId", "value": "" },
    { "key": "prescriptionId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Health check",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      }
    },
    {
      "name": "1. Аутентификация",
      "item": [
        {
          "name": "Регистрация пациента",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Только цифры, 10-15 знаков (валидатор UserService: ^[0-9]{10,15}$). Без '+'.",
                  "var phone = '79' + Math.floor(100000000 + Math.random() * 899999999);",
                  "pm.collectionVariables.set('patientPhone', phone);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200/201', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "var json = pm.response.json();",
                  "if (json.accessToken) { pm.collectionVariables.set('patientToken', json.accessToken); }",
                  "if (json.refreshToken) { pm.collectionVariables.set('refreshToken', json.refreshToken); }",
                  "if (json.userPublicId) { pm.collectionVariables.set('patientUserId', json.userPublicId); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{patientPhone}}\",\n  \"password\": \"{{patientPassword}}\",\n  \"email\": \"patient@example.com\",\n  \"firstName\": \"Иван\",\n  \"secondName\": \"Иванович\",\n  \"surename\": \"Иванов\",\n  \"birthDate\": \"1990-05-15T00:00:00Z\",\n  \"sex\": \"Male\",\n  \"patientProfile\": {\n    \"insuranceNumber\": \"1234567890123456\",\n    \"snils\": \"12345678901\",\n    \"bloodType\": \"OPositive\",\n    \"allergies\": \"нет\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"] }
          }
        },
        {
          "name": "Логин пациента",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('patientToken', json.accessToken);",
                  "pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "if (json.userPublicId) { pm.collectionVariables.set('patientUserId', json.userPublicId); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{patientPhone}}\",\n  \"password\": \"{{patientPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          }
        },
        {
          "name": "Регистрация врача (для doctor-шагов)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var phone = '79' + Math.floor(100000000 + Math.random() * 899999999);",
                  "pm.collectionVariables.set('doctorPhone', phone);"
                ]
              }
            },
            {
              "listen": "test",
