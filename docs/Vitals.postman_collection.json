              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', function () { pm.response.to.have.status(200); });",
                  "try {",
                  "  var json = pm.response.json();",
                  "  var items = json.items || [];",
                  "  if (items.length > 0 && items[0].doctorId) {",
                  "    // Сохраняем найденного врача отдельно, НЕ затирая залогиненного доктора.",
                  "    // Консультацию создаём на {{doctorUserId}} из логина врача, иначе join/complete вернут 403.",
                  "    pm.collectionVariables.set('searchDoctorId', items[0].doctorId);",
                  "  }",
                  "} catch (e) {}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/doctors?specialization=Therapist&page=0&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "doctors"],
