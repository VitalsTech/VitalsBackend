                  "if (json.userPublicId) { pm.collectionVariables.set('doctorUserId', json.userPublicId); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{doctorPhone}}\",\n  \"password\": \"{{doctorPassword}}\",\n  \"email\": \"doctor@example.com\",\n  \"firstName\": \"Пётр\",\n  \"secondName\": \"Петрович\",\n  \"surename\": \"Петров\",\n  \"birthDate\": \"1980-03-10T00:00:00Z\",\n  \"sex\": \"Male\",\n  \"doctorProfile\": {\n    \"specialization\": \"Therapist\",\n    \"diplomaNumber\": \"DPL-0001\",\n    \"diplomaSeries\": \"AB\",\n    \"certificateNumber\": \"CERT-0001\",\n    \"certificateExpiryDate\": \"2035-12-31T00:00:00Z\",\n    \"category\": \"First\",\n    \"academicDegree\": \"Кандидат медицинских наук\",\n    \"biography\": \"Врач-терапевт, стаж 15 лет\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"] }
          }
        },
        {
          "name": "Логин врача",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.collectionVariables.set('doctorToken', json.accessToken);",
                  "if (json.userPublicId) { pm.collectionVariables.set('doctorUserId', json.userPublicId); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{doctorPhone}}\",\n  \"password\": \"{{doctorPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
          }
        }
      ]
    },
