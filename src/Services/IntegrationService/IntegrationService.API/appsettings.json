{
  "Kafka": {
    "Enabled": false,
    "BootstrapServers": "localhost:9092",
    "ConsumerGroupId": "integration-service",
    "ClientId": "integration-service",
    "LabOrderRequiredTopic": "lab.order_required",
    "EmergencyRequiredTopic": "emergency_required"
  },
  "Jwt": {
    "Issuer": "vitals-auth",
    "Audience": "vitals-api",
    "JwksUrl": "http://localhost:5200/internal/jwks",
    "AllowInsecureDevelopmentBypass": false,
    "AllowDevelopmentHeaderFallback": false
  },
  "ServiceAuth": {
    "ApiKey": "vitals-internal-dev-key"
  },
  "ObjectStorage": {
    "UseStub": true,
    "Provider": "S3",
    "BucketName": "vitals-attachments",
    "CdnBaseUrl": "https://cdn.vitals.local"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
