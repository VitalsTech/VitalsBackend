{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5436;Database=RoutingDb;Username=postgres;Password=postgres123"
  },
  "Jwt": {
    "Issuer": "vitals-auth",
    "Audience": "vitals-api",
    "JwksUrl": "http://localhost:5200/internal/jwks",
    "AllowInsecureDevelopmentBypass": false,
    "AllowDevelopmentHeaderFallback": false
  },
  "ServiceAuth": {
    "ApiKey": "vitals-internal-dev-key"
  },
  "UserService": {
    "BaseUrl": "http://localhost:5195",
    "UseStubSchedule": false
  },
  "MedicalRecordService": {
    "BaseUrl": "http://localhost:5210"
  },
  "ConsultationService": {
    "BaseUrl": "http://localhost:5240"
  },
  "PrescriptionService": {
    "BaseUrl": "http://localhost:5250"
  },
  "RoutingEngine": {
    "AlgorithmVersion": "routing-rules-v1",
    "MaxUrgencyWithoutEmergency": 4,
    "DefaultSpecialist": "therapist",
    "PediatricSpecialist": "pediatrician",
    "PediatricMaxAgeYears": 17
  },
  "Kafka": {
    "Enabled": false,
    "BootstrapServers": "localhost:9092",
    "ClientId": "routing-service",
    "TriageCompletedTopic": "triage.completed",
    "RoutingDecisionTopic": "routing.decision",
    "LabOrderRequiredTopic": "lab.order_required",
    "EmergencyRequiredTopic": "emergency_required",
    "AutoResponseRequiredTopic": "auto_response_required",
    "ConsumerGroupId": "routing-service"
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "localhost:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
