{
  "Jwt": {
    "JwksUrl": "http://authservice/internal/jwks"
  },
  "Services": {
    "AuthService": "http://authservice",
    "UserService": "http://userservice",
    "MedicalRecordService": "http://medicalrecord",
    "AITriageService": "http://aitriage",
    "ConsultationService": "http://consultation",
    "PrescriptionService": "http://prescription",
    "NotificationService": "http://notification",
    "PaymentService": "http://payment",
    "AnalyticsService": "http://analytics",
    "QualityService": "http://quality"
  },
  "RateLimiting": {
    "RedisConnectionString": "redis:6379",
    "UseInMemoryFallback": false
  },
  "ReverseProxy": {
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth": { "Address": "http://authservice/" }
        }
      },
      "consultation-cluster": {
        "Destinations": {
          "consultation": { "Address": "http://consultation/" }
        }
      }
    }
  }
}
