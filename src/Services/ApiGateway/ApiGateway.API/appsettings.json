{
  "Jwt": {
    "Issuer": "vitals-auth",
    "Audience": "vitals-api",
    "JwksUrl": "http://localhost:5200/internal/jwks"
  },
  "Services": {
    "AuthService": "http://localhost:5200",
    "UserService": "http://localhost:5195",
    "MedicalRecordService": "http://localhost:5210",
    "AITriageService": "http://localhost:5220",
    "ConsultationService": "http://localhost:5240",
    "PrescriptionService": "http://localhost:5250",
    "NotificationService": "http://localhost:5260"
  },
  "RateLimiting": {
    "RedisConnectionString": "localhost:6379",
    "Policies": {
      "Anonymous": { "PermitLimit": 100, "WindowSeconds": 60, "PartitionBy": "Ip" },
      "Authenticated": { "PermitLimit": 1000, "WindowSeconds": 60, "PartitionBy": "UserId" },
      "Login": { "PermitLimit": 10, "WindowSeconds": 300, "PartitionBy": "Ip" },
      "Register": { "PermitLimit": 5, "WindowSeconds": 3600, "PartitionBy": "Ip" }
    },
    "EndpointRules": [
      { "Path": "/api/v1/auth/login", "Methods": [ "POST" ], "Policy": "Login" },
      { "Path": "/api/v1/auth/register", "Methods": [ "POST" ], "Policy": "Register" }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-esia": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/v1/auth/esia/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/auth/esia/{**catch-all}" }
        ]
      },
      "users": {
        "ClusterId": "users-cluster",
        "Match": { "Path": "/api/v1/users/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/users/{**catch-all}" }
        ]
      },
      "admin": {
        "ClusterId": "users-cluster",
        "Match": { "Path": "/api/v1/admin/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/admin/{**catch-all}" }
        ]
      },
      "medical-records": {
        "ClusterId": "medical-cluster",
        "Match": { "Path": "/api/v1/medical-records/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/medical-records/{**catch-all}" }
        ]
      },
      "triage": {
        "ClusterId": "triage-cluster",
        "Match": { "Path": "/api/v1/triage/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/triage/{**catch-all}" }
        ]
      },
      "consultations": {
        "ClusterId": "consultation-cluster",
        "Match": { "Path": "/api/v1/consultations/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/consultations/{**catch-all}" }
        ]
      },
      "consultation-hub": {
        "ClusterId": "consultation-cluster",
        "Match": { "Path": "/api/v1/consultations/hub/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/hubs/consultation/{**catch-all}" }
        ]
      },
      "prescriptions": {
        "ClusterId": "prescription-cluster",
        "Match": { "Path": "/api/v1/prescriptions/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/prescriptions/{**catch-all}" }
        ]
      },
      "notifications": {
        "ClusterId": "notification-cluster",
        "Match": { "Path": "/api/v1/notifications/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/notifications/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth": { "Address": "http://localhost:5200/" }
        }
      },
      "users-cluster": {
        "Destinations": {
          "users": { "Address": "http://localhost:5195/" }
        }
      },
      "medical-cluster": {
        "Destinations": {
          "medical": { "Address": "http://localhost:5210/" }
        }
      },
      "triage-cluster": {
        "Destinations": {
          "triage": { "Address": "http://localhost:5220/" }
        }
      },
      "consultation-cluster": {
        "Destinations": {
          "consultation": { "Address": "http://localhost:5240/" }
        }
      },
      "prescription-cluster": {
        "Destinations": {
          "prescription": { "Address": "http://localhost:5250/" }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification": { "Address": "http://localhost:5260/" }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*"
}
