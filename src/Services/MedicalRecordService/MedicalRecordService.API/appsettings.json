{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5434;Database=MedicalRecordDb;Username=postgres;Password=postgres123"
  },
  "Jwt": {
    "Issuer": "vitals-auth",
    "Audience": "vitals-api",
    "JwksUrl": "http://localhost:5200/internal/jwks",
    "AllowInsecureDevelopmentBypass": false,
    "AllowDevelopmentHeaderFallback": false
  },
  "ServiceAuth": {
    "ApiKey": "vitals-internal-dev-key"
  },
  "MedicalRecord": {
    "SnapshotEveryEvents": 100
  },
  "Kafka": {
    "Enabled": false,
    "BootstrapServers": "localhost:9092",
    "MedicalEventsTopic": "medical-record.events",
    "PatientMoodUpdatedTopic": "patient.mood.updated",
    "PatientTriageCompletedTopic": "patient.triage.completed",
    "IntegrationInboundTopic": "integration.lab-results"
  },
  "ConsultationService": {
    "BaseUrl": "http://localhost:5240"
  },
  "ObjectStorage": {
    "UseStub": true,
    "Provider": "S3",
    "BucketName": "vitals-medical-attachments",
    "CdnBaseUrl": "https://cdn.vitals.local"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
